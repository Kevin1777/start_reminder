# 企业微信机器人 Webhook。请勿提交真实地址到代码仓库。
WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换为真实key

# 雷速公开赛程页；程序会自动拼接当天日期
SOURCE_URL=https://live.leisu.com/saicheng

# 以中国标准时间显示和判断比赛时间
TIMEZONE=Asia/Shanghai
# 推送固定在北京时间每天 02:00（含）至 07:00（不含）静默，不补发过期提醒

# 五大联赛目标为赛前 10 分钟，程序每分钟检查并保留前后 1 分钟容差
MAJOR_REMINDER_MINUTES=10

# 新增联赛及成年男足国家队赛事的目标提前时间；统一提前 10 分钟
ADDITIONAL_LEAGUE_REMINDER_MINUTES=欧冠:10,葡超:10,美职联:10,墨超:10,荷甲:10,德乙:10,澳超:10,巴西甲:10,阿甲:10,世界杯:10,世预赛:10,世欧预:10,世亚预:10,世南美预:10,世非预:10,世中北美预:10,世大洋预:10,世预附加赛:10,欧洲杯:10,欧洲杯预选赛:10,欧国联:10,亚洲杯:10,亚洲杯预选赛:10,非洲杯:10,非洲杯预选赛:10,美洲杯:10,金杯赛:10,中北美国联:10,欧美杯:10

# 默认使用项目目录下的 data/sent.json；VPS 可改成 /var/lib/... 路径
STATE_FILE=data/sent.json
CACHE_FILE=data/schedule_cache.json

HTTP_TIMEOUT_SECONDS=20
LOG_LEVEL=INFO
DRY_RUN=false
